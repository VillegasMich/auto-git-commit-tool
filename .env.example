# auto-git-commit-tool settings. Copy to .env and fill in:  cp .env.example .env
# Full reference: docs/configuration.md
#
# Format: KEY=value, one per line, no quotes and no spaces around '='. The same file works with
# `docker run --env-file .env`, Docker Compose, and `set -a; . ./.env; set +a` in a shell.
# Never commit .env (it is in .gitignore).

# --- Required -------------------------------------------------------------------------------

# GitHub token. Classic PAT with `repo` scope, or fine-grained with All repositories +
# Administration R/W + Contents R/W + Metadata R. See docs/deployment.md#github-token.
# Alternatively use your gh login: GH_TOKEN=$(gh auth token)
GH_TOKEN=

# --- Optional (defaults shown) --------------------------------------------------------------

# Private repository on your account; created if missing.
REPO_NAME=daily-log

# Daily run time, HH:MM 24-hour, in UTC. Pick a time on the same calendar day in your timezone.
COMMIT_TIME=12:00

# Random number of commits per day, inclusive bounds (1 <= MIN <= MAX <= 50).
MIN_COMMITS=1
MAX_COMMITS=5

# File inside the repo that gets one line per commit.
LOG_FILE=activity.log

# Where the repo is cloned. Keep /data for Docker (mount a volume there). Don't set it for the
# native systemd unit (it uses /var/lib/auto-git-commit-tool). For local runs use e.g.
# DATA_DIR=/home/<you>/.local/share/auto-git-commit
# DATA_DIR=/data

# Commit identity. Defaults: your GitHub login and <id>+<login>@users.noreply.github.com.
# The email must belong to your account or commits won't count on the graph.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=

# Run right after startup if nothing was committed today, even before COMMIT_TIME.
RUN_ON_START=false

# If started after today's COMMIT_TIME with nothing committed today (machine was off), run now.
CATCH_UP=true

# Log level: error, warn, info, debug, trace.
RUST_LOG=info

# --- Notifications (optional) ---------------------------------------------------------------
# Guide: docs/tutorials/notifications.md. Test with: auto-git-commit-tool notify-test

# Master switch: false turns off both emails and healthcheck pings.
NOTIFY_ENABLED=true

# Email after each daily run and when the service is stopped. Unset SMTP_HOST = no email.
# Port 465 = implicit TLS, any other port (e.g. 587) = STARTTLS. Gmail: an app password.
# Sender defaults to SMTP_USERNAME, recipient to the sender.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TLS overrides the port-based choice: implicit or starttls (none: localhost tests only).
# SMTP_TLS=
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=

# Dead-man's switch (e.g. healthchecks.io): pinged every N minutes; it alerts you when the
# pings stop because the machine is off or the service is down. Keep the URL secret.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# HEALTHCHECK_INTERVAL_MINUTES=5
